{
  "name": "@dashral/ui",
  "version": "1.3.1",
  "description": "Accessible React components for dashboards and apps, styled with Tailwind CSS v4. MIT.",
  "license": "MIT",
  "homepage": "https://dashral.com/docs/installation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasralgana/dashral.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/hasralgana/dashral/issues",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "radix-ui",
    "shadcn",
    "dashboard",
    "accessible"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./themes.css": "./src/styles/themes.css",
    "./lib/chart": "./src/lib/chart.tsx",
    "./lib/count-to": "./src/lib/count-to.tsx",
    "./lib/portal": "./src/lib/portal.tsx",
    "./lib/virtual-rows": "./src/lib/virtual-rows.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./globals.css": "./dist/styles/globals.css",
      "./themes.css": "./dist/styles/themes.css",
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf .turbo node_modules",
    "build:npm": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-table": "^9.2.6",
    "@tanstack/react-virtual": "^3.14.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@dashral/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
